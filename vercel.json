{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; font-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'none'; upgrade-insecure-requests"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "value": "public, max-age=604800",
          "key": "Cache-Control"
        }
      ]
    },
    {
      "source": "/(app.js|styles.css|icon.svg)",
      "headers": [
        {
          "value": "public, max-age=3600, stale-while-revalidate=86400",
          "key": "Cache-Control"
        }
      ]
    }
  ],
  "regions": [
    "gru1"
  ]
}
